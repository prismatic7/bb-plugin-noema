{
  "name": "bb-plugin-noema",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Noema",
    "description": "Durable memory for BB threads, backed by your own Noema cortex over its Streamable HTTP MCP endpoints.",
    "branding": {
      "icon": "Zap"
    },
    "server": "./server.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "bb plugin build .",
    "test": "node --test scripts/parse.test.mjs",
    "probe": "node scripts/probe-noema.mjs",
    "integration": "node scripts/factory.integration.mjs"
  }
}
